{
  "github.copilot.enable":{
    "plaintext": false,
    "markdown": false,
    "tests": false,
  },
  "chat.agent.enabled": true,
  "editor.inlineSuggest.enabled": false,
  "files.associations": {
    "tests/*": "tests"
  },
  "files.exclude": {
    "**/.*": true,
    "**/gatorgrade.yml": true
  },
  "[markdown]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 80
  },
  "[python]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 80,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "editor.tabSize": 4,
  "terminal.integrated.commandsToSkipShell": ["aichat.newchataction"],
  "python.analysis.extraPaths": [
    "./src/activity_four/src",
    "./src/activity_five/src"
  ],
  "mpremote.command": "uv run mpremote",
  "mpremote.srcSubdirectory": "src",
  "mpremote.startupCheck.skip": true,
  "mpremote.project.uv": true,
}
